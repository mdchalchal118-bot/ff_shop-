rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mdchalchal118@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isAdmin() && isValidId(productId);
      match /packages/{packageId} {
        allow read: if isValidId(productId) && isValidId(packageId);
        allow write: if isAdmin() && isValidId(productId) && isValidId(packageId);
      }
    }

    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /notices/{noticeId} {
      allow read: if isValidId(noticeId);
      allow write: if isAdmin() && isValidId(noticeId);
    }

    match /banners/{bannerId} {
      allow read: if isValidId(bannerId);
      allow write: if isAdmin() && isValidId(bannerId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isValidId(orderId) &&
        request.resource.data.orderRef is string &&
        request.resource.data.orderType in ['guild_glory', 'diamond_topup'] &&
        request.resource.data.price is number &&
        request.resource.data.paymentStatus in ['pending', 'verified', 'rejected'];
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    match /admins/{userId} {
      allow read, write: if isAdmin() && isValidId(userId);
    }
  }
}
